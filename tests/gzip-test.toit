import expect show *
import io
import zlib

GZIP-DATA ::= #[
  0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0xf3, 0x4a,
  0x4c, 0x2f, 0x4d, 0x2c, 0x52, 0x48, 0xaf, 0xca, 0x2c, 0x50, 0x28, 0x2e,
  0x29, 0x4a, 0x4d, 0xcc, 0xe5, 0x02, 0x00, 0x0b, 0xca, 0x54, 0x88, 0x13,
  0x00, 0x00, 0x00,
]

main:
  decoder := zlib.GzipDecoder
  task::
    decoder.out.write GZIP-DATA
    decoder.out.close

  output := io.Buffer
  while chunk := decoder.in.read:
    output.write chunk
  expect-equals "Jaguar gzip stream\n" output.bytes.to-string
